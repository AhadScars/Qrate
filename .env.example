# Supabase → Connect → ORMs → Prisma. Paste the values in Vercel, not in chat.
# DATABASE_URL is the transaction pooler (port 6543, must include pgbouncer=true).
# DIRECT_URL is the session pooler (port 5432). Used only by migrations.
DATABASE_URL="postgresql://USER:PASSWORD@HOST:6543/postgres?pgbouncer=true&connection_limit=1"
DIRECT_URL="postgresql://USER:PASSWORD@HOST:5432/postgres"

# Public site address. On Vercel this is https://your-project.vercel.app
APP_URL="http://localhost:3000"

# First super admin. On Vercel set both. The password is not stored in git.
ADMIN_EMAIL="admin@qrate.local"
ADMIN_PASSWORD=""

# These four are Supabase API keys. Qrate does not read them.
# Login stays on Qrate's own session cookie. Keep them only if you add Supabase Auth later.
# SUPABASE_URL
# SUPABASE_PUBLISHABLE_KEY
# SUPABASE_SECRET_KEY
# SUPABASE_JWKS_URL

# Optional. When both are set, password reset emails send through Resend.
# When they are empty, the reset page shows the link on screen.
RESEND_API_KEY=""
EMAIL_FROM=""
